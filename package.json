{
  "name": "@poggufanz/rocky-cli",
  "version": "0.4.0",
  "description": "A blind engineer who lives in your terminal, never forgets an error, and makes sure you still understand your own code.",
  "type": "module",
  "bin": {
    "rocky": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/commands",
    "dist/check",
    "dist/core",
    "dist/ui",
    "dist/mcp",
    "dist/setup",
    "dist/ai",
    "dist/agent",
    "dist/shell",
    "skills/rocky-voice",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "node scripts/test.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "benchmark:mcp": "npm run build --silent && node scripts/benchmark-mcp.mjs",
    "release:check": "node scripts/release-check.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "terminal-pet",
    "developer-tools",
    "error-memory",
    "project-hail-mary"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poggufanz/rocky.git"
  },
  "homepage": "https://github.com/poggufanz/rocky#readme",
  "bugs": {
    "url": "https://github.com/poggufanz/rocky/issues"
  },
  "author": "Muhammad Faiq",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^18.19.0"
  }
}
